@using Cropper.Blazor.Models

<div class="img-container cropper-js-api-canvas-element" data-testid="cropper-js-api-canvas-element">
    <CropperComponent Class="big-img" Src="images/Rivne.jpg" Options="cropperOptions">
        <CropperCanvasElement Background="false" ScaleStep="0.2m" ThemeColor="rgba(51, 153, 255, 0.12)" />
    </CropperComponent>
</div>

@code {
    private readonly Options cropperOptions = new();
}

<style>
    .big-img {
        max-height: 420px;
        max-width: 100%;
    }

    .img-container {
        max-height: 420px;
        width: 100%;
    }
</style>
