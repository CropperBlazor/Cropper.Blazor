@using Cropper.Blazor.Client.Components.Docs
@using Cropper.Blazor.Shared.Attributes
@using Cropper.Blazor.Shared.Models

@if (ComponentType is not null && !HasName)
{
    <SeoHeader Title="API - Cropper.Blazor"
               Overview="Cropper component API."
               Keywords="@(
               new[] { "API", "Cropper component API", "Cropper API", "Cropper.Blazor component API", "Cropper.Blazor API" })" />
}
else if (ComponentType is not null && HasName)
{
    <SeoHeader Title="@($"Contract {Name} - Cropper.Blazor")"
               Overview="@($"Contract {Name}.")"
               Keywords="@(
               new[] { Name, $"Contract {Name}" })" />
}

<DocsApi Type="@ComponentType" IsContract="@IsContract" IsComponentContract="@IsComponentContract" />
