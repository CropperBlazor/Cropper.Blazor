@page "/examples/viewmodes"
@page "/v1/examples/viewmodes"
@page "/v2/examples/viewmodes"
@using Cropper.Blazor.Client.Pages.ViewModes.Examples

<SeoHeader Title="View Modes - Cropper.Blazor"
           Overview="Define the view mode of the cropper."
           Keywords="@(
            new []
            {
                "View Modes",
                "View Modes Cropper.Blazor",
                "View Modes Cropper"
            })" />

<DocsPage>
    <DocsPageHeader Title="View Modes" SubTitle="Define the view mode of the cropper." />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Cropper.js v2 migration usage">
                <Description>
                    Cropper.js v2 removed the legacy <CodeInline>viewMode</CodeInline> option. Use the <CodeInline>cropper-image</CodeInline> <CodeInline>transform</CodeInline> event
                    to limit image boundaries and the <CodeInline>cropper-selection</CodeInline> <CodeInline>change</CodeInline> event to limit selection boundaries on the client side.
                    <br><br>
                    This example keeps VM0 through VM3 as demo presets and applies the equivalent v1 behavior with Cropper.js v2 custom element APIs:
                    <MudList T="string">
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                            <CodeInline>Vm0</CodeInline> - no restrictions;
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Secondary">
                            <CodeInline>Vm1</CodeInline> - restrict the crop box not 
                            to exceed the size of the canvas;
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                            <CodeInline>Vm2</CodeInline> - restrict the minimum canvas size 
                            to fit within the container. If the proportions of the canvas 
                            and the container differ, the minimum canvas will be surrounded 
                            by extra space in one of the dimensions;
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Secondary">
                            <CodeInline>Vm3</CodeInline> - restrict the minimum canvas size to fill the container. 
                            If the proportions of the canvas and the container are different, 
                            the container will not be able to fit the whole canvas in one of the dimensions;
                        </MudListItem>
                    </MudList>
                    <br>
                    <MudAlert Class="mt-3" Severity="Severity.Info">
                        <CodeInline>Vm0</CodeInline>, the crop box can extend outside the canvas, 
                        while a value of <CodeInline>Vm1</CodeInline>, <CodeInline>Vm2</CodeInline>, 
                        or <CodeInline>Vm3</CodeInline> restricts the crop box to the size of the canvas.
                    </MudAlert>

                    <MudAlert Class="mt-2" Severity="Severity.Info">
                        <CodeInline>Vm2</CodeInline> and <CodeInline>Vm3</CodeInline> additionally restrict the image canvas to the container.
                        <br>
                        There is no difference between <CodeInline>Vm2</CodeInline> and <CodeInline>Vm3</CodeInline> 
                        when the proportions of the canvas and the container are the same.
                    </MudAlert>
                </Description>
            </SectionHeader>
            <SectionContent Code="typeof(AllViewModesExample)">
                <AllViewModesExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
