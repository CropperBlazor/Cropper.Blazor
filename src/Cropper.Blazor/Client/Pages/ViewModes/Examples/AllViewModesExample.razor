@using Cropper.Blazor.Client.Enums
@using Cropper.Blazor.Models
@inject IJSRuntime JSRuntime

<div class="img-container" @ref="cropperContainer">
    <CropperComponent @ref="cropperComponent"
                      Src="images/Rivne.jpg"
                      Options="cropperOptions"
                      Class="big-img" />
</div>

<MudButtonGroup Color="Color.Primary" Variant="Variant.Filled" OverrideStyles="false" Class="mud-width-full">
    <MudTooltip Text="View Mode 0" RootClass="mud-width-full">
        <MudButton OnClick="@(() => SetViewModeAsync(CropperViewMode.Vm0))" Color="Color.Primary" Variant="Variant.Filled" Class="ml-0"
                   Style="@(viewMode == CropperViewMode.Vm0 ? "background-color: var(--mud-palette-primary-darken)" : "")" FullWidth="true">
            VM0
        </MudButton>
    </MudTooltip>
    <MudTooltip Text="View Mode 1" RootClass="mud-width-full">
        <MudButton OnClick="@(() => SetViewModeAsync(CropperViewMode.Vm1))" Color="Color.Primary" Variant="Variant.Filled" Class="ml-0"
                   Style="@(viewMode == CropperViewMode.Vm1 ? "background-color: var(--mud-palette-primary-darken)" : "")" FullWidth="true">
            VM1
        </MudButton>
    </MudTooltip>
    <MudTooltip Text="View Mode 2" RootClass="mud-width-full">
        <MudButton OnClick="@(() => SetViewModeAsync(CropperViewMode.Vm2))" Color="Color.Primary" Variant="Variant.Filled" Class="ml-0"
                   Style="@(viewMode == CropperViewMode.Vm2 ? "background-color: var(--mud-palette-primary-darken)" : "")" FullWidth="true">
            VM2
        </MudButton>
    </MudTooltip>
    <MudTooltip Text="View Mode 3" RootClass="mud-width-full">
        <MudButton OnClick="@(() => SetViewModeAsync(CropperViewMode.Vm3))" Color="Color.Primary" Variant="Variant.Filled" Class="ml-0"
                   Style="@(viewMode == CropperViewMode.Vm3 ? "background-color: var(--mud-palette-primary-darken)" : "")" FullWidth="true">
            VM3
        </MudButton>
    </MudTooltip>
</MudButtonGroup>

@code {
    private CropperComponent? cropperComponent = null!;
    private ElementReference cropperContainer;
    private CropperViewMode viewMode = CropperViewMode.Vm3;

    private readonly Options cropperOptions = new Options();

    public async Task SetViewModeAsync(CropperViewMode value)
    {
        viewMode = value;
        await ApplyViewModeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyViewModeAsync();
        }
    }

    private async Task ApplyViewModeAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.cropperViewMode.attach", cropperContainer, (int)viewMode);
    }
}

<style>
    .big-img {
        max-height: 400px;
        /* This rule is very important, please don't ignore this */
        max-width: 100%;
    }

    .img-container {
        max-height: 400px;
        width: 100%;
    }
</style>
