<MudCard Class="mud-height-full" data-testid="zoom-ratio-settings">
    <MudCardHeader Class="border-solid border-b mud-border-lines-default">
        <CardHeaderContent>
            <div class="d-flex flex-column gap-2">
                <MudText Typo="Typo.h5">Zoom ratio limits</MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Clamp zoom changes for the current component and keep the latest zoom event values visible.
                </MudAlert>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="mud-height-full pt-0">
        <div class="d-flex gap-x-6 flex-wrap flex-sm-nowrap">
            <MudNumericField @bind-Value="MinZoomRatio" Label="Min zoom ratio" data-testid="zoom-min-ratio"
                             Min="0" Max="MaxZoomRatio">
            </MudNumericField>
            <MudNumericField @bind-Value="MaxZoomRatio" Label="Max zoom ratio" data-testid="zoom-max-ratio"
                             Min="MinZoomRatio ?? 0">
            </MudNumericField>
        </div>
        <div class="d-flex align-end gap-x-6">
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Class="flex-1 ma-0 mt-4">
                Zoom event old ratio:
            </MudChip>
            <MudNumericField @bind-Value="OldRatio" Format="N2" Variant="Variant.Text" data-testid="zoom-old-ratio"
                             HideSpinButtons="true" ReadOnly="true" Class="flex-1" />
        </div>
        <div class="d-flex align-end gap-x-6">
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Class="flex-1 ma-0 mt-4">
                Zoom event ratio:
            </MudChip>
            <MudNumericField @bind-Value="CurrentRatio" Format="N2" Variant="Variant.Text" data-testid="zoom-current-ratio"
                             HideSpinButtons="true" ReadOnly="true" Class="flex-1" />
        </div>
    </MudCardContent>
</MudCard>
