{
  "compilerOptions": {
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "types": [ "node" ],
    "lib": [ "es2020", "dom" ],
    "preserveConstEnums": true,
    "allowJs": false,
    "declaration": false
  },
  "exclude": [ "./node_modules", "./**/*.test.ts", "./**/*.coverage.test.ts", "./**/*.spec.ts" ],
  "include": [
    "./Cropper/types/global/*.d.ts",
    "./node_modules/cropperjs/dist/cropper.d.ts",
    "./Cropper/**/*.ts",
    "./Cropper/*.ts"
  ]
}
