{
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "es6",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [ "es2016", "dom" ],
    "strict": true,
    "alwaysStrict": true,
    "preserveConstEnums": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "cropperjs/*": [ "node_modules/cropperjs/src/*" ],
      "vitest/*": [ "node_modules/vitest/*" ]
    },
    "declaration": false
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "Cropper/types/global/*.d.ts",
    "Cropper/**/*.ts",
    "Cropper/*.ts",
    "vitest.config.ts"
  ]
}
