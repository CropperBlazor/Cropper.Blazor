{
  "compilerOptions": {
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": [ "es2016", "dom" ],
    "preserveConstEnums": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "cropperjs/*": [ "node_modules/cropperjs/src/*" ],
      "vitest/*": [ "node_modules/vitest/*" ]
    },
    "declaration": false
  },
  "exclude": [ "node_modules" ],
  "include": [
    "Cropper/types/global/*.d.ts",
    "Cropper/**/*.ts",
    "Cropper/*.ts",
    "vitest.config.ts"
  ]
}
