@page "/v1"
@layout LandingLayout
@attribute [SitemapUrl(changeFreq: ChangeFreq.Monthly, priority: 0.5)]

@using Cropper.Blazor.Shared.Attributes
@using Cropper.Blazor.Shared.Models

<SeoHeader Title="Cropper.js v1 Demo - Cropper.Blazor"
           Overview="Legacy Cropper.js 1.6.2 example route for Cropper.Blazor."
           Keywords="@(
            new []
            {
                "demo",
                "cropperjs-v1"
            })" />

<MudContainer Class="mt-5 px-4">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h4" Class="mb-3">Cropper.js v1 example</MudText>
        <MudText Class="mb-4">
            This route is reserved for the legacy Cropper.js 1.6.2 example so v1 and v2 documentation links stay separate.
            The active component package is migrated to Cropper.js 2.1.1, so interactive examples are available on the v2 route.
        </MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/v2">
            Open Cropper.js v2 demo
        </MudButton>
    </MudPaper>
</MudContainer>
