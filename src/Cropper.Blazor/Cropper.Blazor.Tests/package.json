{
  "name": "cropper.blazor.tests",
  "version": "1.5.1",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:debug": "vitest run --inspect-brk=127.0.0.1:9229 --pool=threads --poolOptions.threads.singleThread=true --poolOptions.threads.isolate=false --no-file-parallelism",
    "test:debug:watch": "vitest --inspect-brk=127.0.0.1:9229 --pool=threads --poolOptions.threads.singleThread=true --poolOptions.threads.isolate=false --no-file-parallelism",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "coverage": "cd ../Cropper.Blazor && npm exec -- vitest run --coverage --config vitest.coverage.config.ts"
  },
  "dependencies": {
    "jsdom": "27.2.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
